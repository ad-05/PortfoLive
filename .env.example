# Backend env vars (copy to server/.env or set in k8s Secret)
APP_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=you@example.com
# STORAGE=local (default, dev) or s3 (production)
STORAGE=local
S3_BUCKET=
# Leave the distribution id empty to serve from S3 website hosting; then CLOUDFRONT_URL is the S3 website URL.
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_URL=https://dxxxxxxxx.cloudfront.net
AWS_REGION=ap-south-1
