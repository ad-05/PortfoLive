{% extends "_base.html.j2" %}
{% block theme %}:root{--bg:#faf7ff;--fg:#1e1b4b;--accent:#7c3aed;--accent-2:#ec4899;--card:#ffffff;--border:rgba(124,58,237,.16);--font:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--radius:20px}
.hero{margin:24px 0 0;padding:44px 40px;border-radius:28px;background:linear-gradient(135deg,#7c3aed,#ec4899 60%,#f59e0b);color:#fff;box-shadow:0 20px 50px rgba(124,58,237,.3)}
.hero h1,.hero .sub,.hero .bio{color:#fff}
.hero .avatar{background:rgba(255,255,255,.22);border:2px solid rgba(255,255,255,.6);box-shadow:none}
.hero .btn{background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.4);color:#fff}
.hero .btn svg{color:#fff}
@media(max-width:640px){.hero{padding:32px 24px}}{% endblock %}
