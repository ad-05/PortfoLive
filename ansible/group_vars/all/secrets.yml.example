# Copy to secrets.yml and fill in. secrets.yml is git-ignored. Encrypt it with:  ansible-vault encrypt group_vars/all/secrets.yml
# (then run playbooks with --ask-vault-pass).  Every CHANGE_ME must be replaced or the playbook refuses to run.
jwt_secret: CHANGE_ME             # 32+ random characters:  openssl rand -hex 32
admin_email: CHANGE_ME            # register with this email in the app to get the Admin tab
grafana_admin_password: CHANGE_ME
sonar_db_password: CHANGE_ME
# Slack (or Teams) incoming-webhook URL for Alertmanager. Leave as-is to skip alert delivery for now.
slack_webhook_url: "https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK"
