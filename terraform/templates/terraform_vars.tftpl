# GENERATED by Terraform (contains secrets, git-ignored). Values the app needs on AWS.
aws_region: ${region}
s3_bucket: ${bucket}
cloudfront_distribution_id: "${distribution_id}"   # empty when CloudFront is off
cloudfront_url: "${cdn_url}"                         # CloudFront URL, or the S3 website URL when it is off
aws_access_key_id: ${access_key_id}
aws_secret_access_key: ${secret_key}
